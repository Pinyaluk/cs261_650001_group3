    {
      "name": "U2 Login",
      "item": [
        {
          "name": "01 Login สำเร็จ (resident01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ได้ 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"มี token\", () => pm.expect(j.token).to.be.a(\"string\"));",
                  "pm.test(\"role = RESIDENT\", () => pm.expect(j.role).to.eql(\"RESIDENT\"));",
                  "pm.test(\"ไม่ส่ง passwordHash ออกมา\", () => pm.expect(j).to.not.have.property(\"passwordHash\"));",
                  "pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "U2: รหัสถูก → 200 ได้ token เก็บไว้ใช้ทุก request",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"resident01\", \"password\": \"password123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
